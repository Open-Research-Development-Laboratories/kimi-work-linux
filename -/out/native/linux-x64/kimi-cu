#!/bin/sh
set -eu

# Relocatable launcher for the Linux-native Computer Use MCP bridge.  The
# settings UI uses the short `kimi-cu` command; this copy resolves the active
# packaged release without depending on a macOS .app path or a shell cwd.
ROOT="${KIMI_CU_ROOT:-}"
SELF=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
SELF_DIR=$(dirname -- "$SELF")
if [ -z "$ROOT" ]; then
  if [ -r "$SELF_DIR/kimi-cu-root" ]; then
    CANDIDATE=$(head -n 1 "$SELF_DIR/kimi-cu-root" 2>/dev/null || true)
    if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE/resources/resources/runtime/node" ] && [ -f "$CANDIDATE/resources/resources/kimi-cu.cjs" ]; then ROOT="$CANDIDATE"; fi
  fi
fi
if [ -z "$ROOT" ]; then
  for CANDIDATE in \
    "$(readlink -f -- "$SELF_DIR/../.." 2>/dev/null || true)" \
    "$(readlink -f -- "$SELF_DIR/../../.." 2>/dev/null || true)"; do
    if [ -x "$CANDIDATE/resources/resources/runtime/node" ] && [ -f "$CANDIDATE/resources/resources/kimi-cu.cjs" ]; then
      ROOT="$CANDIDATE"
      break
    fi
  done
fi
if [ -z "$ROOT" ]; then
  for EXE in /proc/[0-9]*/exe; do
    TARGET=$(readlink -f -- "$EXE" 2>/dev/null || true)
    case "$TARGET" in
      */kimi-work|*/electron)
        CANDIDATE=$(dirname -- "$TARGET")
        if [ -x "$CANDIDATE/resources/resources/runtime/node" ] && [ -f "$CANDIDATE/resources/resources/kimi-cu.cjs" ]; then ROOT="$CANDIDATE"; break; fi
        ;;
    esac
  done
fi
[ -n "$ROOT" ] || { printf '%s\n' 'Kimi Computer Use cannot locate its packaged Linux runtime.' >&2; exit 127; }
NODE="${KIMI_CU_NODE:-$ROOT/resources/resources/runtime/node}"
PAYLOAD="${KIMI_CU_PAYLOAD:-$ROOT/resources/resources/kimi-cu.cjs}"
[ -x "$NODE" ] || { printf 'Kimi Computer Use requires embedded Node: %s\n' "$NODE" >&2; exit 127; }
[ -f "$PAYLOAD" ] || { printf 'Kimi Computer Use payload is missing: %s\n' "$PAYLOAD" >&2; exit 127; }
exec "$NODE" "$PAYLOAD" "$@"
